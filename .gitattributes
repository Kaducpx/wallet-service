* text=auto
# Código e scripts que rodam em containers Linux usam LF em qualquer sistema.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
# Script do Windows usa CRLF.
*.ps1 text eol=crlf
