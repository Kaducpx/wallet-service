# Valores de EXEMPLO para desenvolvimento local. Nenhum segredo real.
# Copie para .env se quiser alterar algo (o docker compose lê .env).

# --- Docker Compose ---------------------------------------------------------
POSTGRES_PASSWORD=wallet_owner_local
POSTGRES_APP_PASSWORD=wallet_app_local
POSTGRES_PORT=55432
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_PASSWORD=admin
LOCALSTACK_PORT=4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOG_LEVEL=info

# --- Aplicação rodando fora do Docker (go run ./cmd/wallet-service) ---------
# DATABASE_URL=postgres://wallet_app:wallet_app_local@localhost:55432/wallet?sslmode=disable
# MIGRATIONS_DATABASE_URL=postgres://wallet_owner:wallet_owner_local@localhost:55432/wallet?sslmode=disable
# OIDC_ISSUER=http://localhost:8080/realms/wallet
# OIDC_JWKS_URL=http://localhost:8080/realms/wallet/protocol/openid-connect/certs
# OIDC_AUDIENCE=wallet-service
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localhost:4566
# HTTP_ADDR=:8081
# SHUTDOWN_TIMEOUT=25s
# SQS_QUEUE_NAME=wager-transactions.fifo
# SQS_DLQ_NAME=wager-transactions-dlq.fifo
# SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
# PENDING_TTL=10m
# PENDING_MAX_ATTEMPTS=20

# --- Clients do Keycloak provisionados automaticamente (somente local) ------
# provider-a            / provider-a-local-secret         (papel wager-provider, provider_id=provider-a)
# provider-b            / provider-b-local-secret         (papel wager-provider, provider_id=provider-b)
# provider-a-short-lived/ provider-a-short-local-secret   (igual ao provider-a, token de 3s)
# wallet-backoffice     / wallet-backoffice-local-secret  (papel wallet-operator)
# no-role-client        / no-role-local-secret            (sem papéis)
